# ── LLM Provider Configuration ────────────────────────────────────────────────
# Set at least one API key. The app auto-detects which providers are available
# and falls back to the next configured provider on rate-limit or failure.
#
# Priority order: Groq → NVIDIA NIM → OpenRouter → Google Gemini

# Groq — fast inference, generous free tier (llama-3.3-70b-versatile)
# Get a key at: https://console.groq.com/
GROQ_API_KEY=

# NVIDIA NIM — NVIDIA-hosted Llama/Mistral models, free credits
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# OpenRouter — routes to 200+ models, many free
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — gemini-2.0-flash, free via AI Studio
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# Force a specific provider (groq | nvidia | openrouter | google).
# If unset, the first provider with a key set above is used.
# LLM_PROVIDER=groq

# Override the model for the selected provider.
# If unset, the provider's recommended free model is used.
# LLM_MODEL=llama-3.3-70b-versatile
